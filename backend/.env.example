# Finnhub API Key - 免费注册 https://finnhub.io/register
FINNHUB_API_KEY=
# 告警检查间隔（秒）
ALERT_CHECK_INTERVAL=300
# 是否启用告警
ALERT_ENABLED=true
# Webhook URL（Slack 兼容格式），留空则不推送
ALERT_WEBHOOK_URL=

# ── 每日简报 ────────────────────────────────────────────────
# 是否启用每日简报（定时生成）
BRIEFING_ENABLED=true
# 生成时间（北京时间 HH:MM）
BRIEFING_TIME=08:30
# LLM API Key（留空则使用模板生成，不调用任何外部服务）
LLM_API_KEY=
# LLM API 地址（OpenAI 兼容格式）
LLM_BASE_URL=https://api.deepseek.com/v1
# LLM 模型名
LLM_MODEL=deepseek-chat
